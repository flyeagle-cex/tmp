  quizList:
  - videoClip: {fileID: 0}
    question: "\u6DEE\u5B89\u7684\u6E05\u6C5F\u6D66\u4E3A\u4EC0\u4E48\u88AB\u79F0\u4E3A\u5927\u8FD0\u6CB3\u7684\"\u5341\u5B57\u8DEF\u53E3\"\uFF1F"
    answers:
    - "A. \u56E0\u4E3A\u8FD9\u91CC\u6709\u56DB\u6761\u9A6C\u8DEF\u4EA4\u53C9"
    - "B. \u56E0\u4E3A\u4EAC\u676D\u5927\u8FD0\u6CB3\u548C\u6DEE\u6CB3\u5728\u8FD9\u91CC\u4EA4\u6C47\uFF0C\u662F\u6F15\u8FD0\u5FC5\u7ECF\u4E4B\u5730"
    - "C. \u56E0\u4E3A\u8FD9\u91CC\u662F\u6DEE\u5B89\u7684\u5E02\u4E2D\u5FC3"
    - "D. \u56E0\u4E3A\u8FD9\u91CC\u6709\u5341\u5EA7\u6865"
    correctIndex: 1
    successMessage: "\u592A\u68D2\u4E86\uFF01\u6E05\u6C5F\u6D66\u53EF\u662F\u53E4\u4EE3\u8FD0\u6CB3\u4E0A\u6700\u7E41\u5FD9\u7684\u4EA4\u901A\u67A2\u7EBD\u54E6\uFF01"
  - videoClip: {fileID: 0}
    question: "\u6CB3\u4E0B\u53E4\u9547\u662F\u4E00\u4E2A\u53EA\u6709\u51E0\u5341\u5E74\u5386\u53F2\u7684\u65B0\u5EFA\u5C0F\u9547\u3002"
    answers:
    - "\u6B63\u786E "
    - "\u9519\u8BEF"
    correctIndex: 1
    successMessage: "\u6CB3\u4E0B\u53E4\u9547\u5DF2\u7ECF\u67092500\u591A\u5E74\u5386\u53F2\u5566\uFF01"
  - videoClip: {fileID: 0}
    question: "\u300A\u897F\u6E38\u8BB0\u300B\u7684\u4F5C\u8005\u5434\u627F\u6069\u662F\u54EA\u91CC\u4EBA\uFF1F"
    answers:
    - "A. \u5357\u4EAC\u4EBA"
    - "B. \u82CF\u5DDE\u4EBA"
    - "C. \u6DEE\u5B89\u4EBA"
    - "D. \u626C\u5DDE\u4EBA"
    correctIndex: 2
    successMessage: "\u7B54\u5BF9\u5566\uFF01\u5434\u627F\u6069\u7684\u6545\u5C45\u5C31\u5728\u6DEE\u5B89\u6CB3\u4E0B\u53E4\u9547\u54E6~"
  - videoClip: {fileID: 0}
    question: "\u6211\u60F3\u5403\u4E00\uFF08  \uFF09\u957F\u9C7C\u9762\u3002"
    answers:
    - "\u7897"
    - "\u9053"
    - "\u76D8"
    - "\u4E2A"
    correctIndex: 0
    successMessage: "\u4F60\u5DF2\u7ECF\u662F\u6DEE\u5B89\u7F8E\u98DF\u5C0F\u8FBE\u4EBA\u5566\uFF01"
  - videoClip: {fileID: 0}
    question: "\u4E2D\u56FD\u5357\u5317\u5730\u7406\u5206\u754C\u7EBF\"\u79E6\u5CAD\u2014\u6DEE\u6CB3\u4E00\u7EBF\"\u7ECF\u8FC7\u4E0B\u9762\u54EA\u5EA7\u57CE\u5E02\uFF1F"
    answers:
    - "A. \u82CF\u5DDE"
    - "B. \u6DEE\u5B89"
    - "C. \u5357\u4EAC"
    - "D. \u65E0\u9521"
    correctIndex: 1
    successMessage: "\u592A\u5389\u5BB3\u5566\uFF01\u6DEE\u5B89\u53EF\u662F\u4E2D\u56FD\u5357\u5317\u5206\u754C\u7684\u6807\u5FD7\u6027\u57CE\u5E02\u54E6\uFF01"
